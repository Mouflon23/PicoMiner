# Copy to .env, which git ignores. All of this is optional: without Wi-Fi and a
# BTC address the firmware opens the PicoMinerAP setup portal, and settings saved
# there replace the ones below.
WIFI_SSID=
WIFI_PASSWORD=
BTC_ADDRESS=

# Optional, these are the defaults.
POOL_HOST=pool.solomining.de
POOL_PORT=3333
WORKER=picominer

# Clock in MHz and core voltage in millivolts. The RP2040 datasheet stops at 200
# MHz and 1150 mV; anything above is overclocking, and every chip differs.
SYS_MHZ=200
CORE_MV=1150

# The same for the Pico 2 W, which has its own defaults. Its datasheet stops at
# 150 MHz and 1100 mV.
WORKER_RP2350=picominer2
SYS_MHZ_RP2350=150
CORE_MV_RP2350=1100
